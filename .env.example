# Copy to .env or export in shell. Backend = ONE var: TYPESAFE_BASE_URL.
# Cloud Jev (verified jev-1.14.0): TYPESAFE_BASE_URL=https://api.typesafe.ai
# Local StartLux 4-bit (verified model StartLux-Decision-4B-MLX-4bit): TYPESAFE_BASE_URL=http://localhost:8090

# Real Jev key (already linked globally; keep for cloud swap-back)
TYPESAFE_API_KEY=local
# Local server ignores auth when it has no keys; SDK needs any non-empty string.
# For cloud Jev, replace with the real key from https://console.typesafe.ai/keys

TYPESAFE_BASE_URL=http://localhost:8090
TYPESAFE_DEFAULT_MODEL=StartLux-Decision-v1.1-4B-Instant
DECISION_MODEL=StartLux-Decision-v1.1-4B-Instant
DECISION_BACKEND=local-startlux-4bit-mlx

# BlindDeck JSON-RPC endpoint (the mod serves this itself once Balatro is running).
# The TypeScript agent defaults to it; balatro_controller.py stays dry-run while it is unset.
# BALATRO_API_URL=http://127.0.0.1:12346

# Policy gates (see balatro_controller.py apply_policy)
NONE_THRESHOLD=0.2
MIN_CONFIDENCE=0.55
